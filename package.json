{
  "name": "canva-mcp-pro",
  "version": "3.0.0",
  "description": "High-fidelity Enterprise Presentation & Canva MCP Server bridging local Python vector rendering with Canva Cloud Connect API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "canva-mcp-pro": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "manifest.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node scripts/run_evals.js",
    "diagnose": "node dist/index.js --test",
    "config": "node dist/index.js --config",
    "package:mcpb": "node scripts/build_mcpb.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leanhduyp/canva-mcp-pro.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "canva",
    "powerpoint",
    "presentation",
    "pptx",
    "ai-agent",
    "antigravity",
    "claude-desktop",
    "taste-skill"
  ],
  "author": "Lê Anh Duy <mrduy@enterprise-ai.vn>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
