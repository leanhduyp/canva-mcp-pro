# Canva MCP Pro - Environment Variables Configuration

# (Optional) Canva Connect Cloud REST API Access Token
# If left empty, Canva MCP Pro gracefully operates in Local Offline Mode.
CANVA_ACCESS_TOKEN=

# (Optional) Default output directory or presentation path
DEFAULT_PRESENTATION_PATH=./output/presentation.pptx

# (Optional) Default presenter name displayed on badge
DEFAULT_PRESENTER=Lê Anh Duy
