# ========================================================
# Canva MCP Pro (v3.2.0 Enterprise Configuration)
# ========================================================

# 1. Canva Cloud Connect API (Optional: leave empty for graceful offline mock)
CANVA_ACCESS_TOKEN=

# 2. Default Presentation Path (Fallback if not provided per tool invocation)
DEFAULT_PRESENTATION_PATH=

# 3. Presenter Default Badge
DEFAULT_PRESENTER="Lê Anh Duy"

# 4. Enterprise Security Execution Mode:
# - declarative_json_only (Recommended for Production - 100% RCE-proof)
# - sandboxed_script (For Local Dev only - Enforces 500ms timeout & AST reflection blocklist)
CANVA_MCP_EXECUTION_MODE=declarative_json_only

# 5. Mandatory Comment Preview (Dry-Run Enforcement)
# Forces preview_mode: true on all feedback received from Canva Cloud to prevent semantic prompt manipulation
CANVA_MCP_FORCE_COMMENT_PREVIEW=true

# 6. Workspace Lifecycle & Disk Quota DoS Protection
CANVA_MCP_TMP_TTL_SECONDS=900
CANVA_MCP_MAX_WORKSPACE_MB=50

# 7. Output directory override (Optional)
# MCP_OUTPUT_DIR=/custom/output/directory
